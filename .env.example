# Postgres connection string (Neon nebo Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Min. 32 znaků — podpis účastnické i admin session cookie (jose/HS256).
# Vygeneruj: npm run gen:secrets
SESSION_SECRET=""

# Náhodný token ve výsledkové URL /r/{token}, např. 24 znaků.
# Vygeneruj: npm run gen:secrets
ADMIN_URL_TOKEN=""

# Heslo k výsledkové stránce.
ADMIN_PASSWORD=""

# Absolutní base URL nasazené aplikace, BEZ lomítka na konci.
# Používá se pro generování QR kódů a odkazů. V lokálním vývoji např. http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
